{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/privacy",
      "destination": "https://legal.greencube.app/privacy",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "https://legal.greencube.app/terms",
      "permanent": true
    },
    {
      "source": "/install.sh",
      "destination": "https://greencube.app/download",
      "permanent": true
    },

    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": "es(-[A-Za-z]+)?([;,].*)?" }],
      "missing": [
        { "type": "cookie", "key": "gc_lang" },
        { "type": "header", "key": "user-agent", "value": "(?i).*(bot|crawl|spider|slurp|facebookexternalhit|embedly|preview|lighthouse|headless).*" }
      ],
      "destination": "/es/",
      "permanent": false
    },
    {
      "source": "/:page(buy|how-it-works|your-data|mission|ai-environmental-impact|how-much-water-does-ai-use)",
      "has": [{ "type": "header", "key": "accept-language", "value": "es(-[A-Za-z]+)?([;,].*)?" }],
      "missing": [
        { "type": "cookie", "key": "gc_lang" },
        { "type": "header", "key": "user-agent", "value": "(?i).*(bot|crawl|spider|slurp|facebookexternalhit|embedly|preview|lighthouse|headless).*" }
      ],
      "destination": "/es/:page",
      "permanent": false
    },

    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "greencube.world" }],
      "destination": "https://greencube.app/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.greencube.world" }],
      "destination": "https://greencube.app/:path*",
      "statusCode": 301
    }
  ]
}
